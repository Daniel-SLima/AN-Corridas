<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/primo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="11dp"
    android:background="@drawable/primo_widget_bg"
    android:contentDescription="Abrir o menu flutuante do Primo">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primo" android:textStyle="bold"
            android:textColor="#FFFFFF" android:textSize="20sp" />
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abrir registro rápido"
            android:textColor="#FFFFFF" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:background="@drawable/primo_widget_plus_bg"
        android:text="+" android:textSize="32sp"
        android:textColor="#172B3A" />
</LinearLayout>
